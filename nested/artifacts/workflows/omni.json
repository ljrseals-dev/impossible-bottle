{
  "1": {
    "class_type": "OmniPSDLoader",
    "inputs": {
      "flux_checkpoint": "flux1-dev.safetensors",
      "kontext_checkpoint": "flux1-kontext-dev.safetensors",
      "rgba_vae": "flux1-dev-alpha.safetensors",
      "content_front_lora": "omni_content_front.safetensors",
      "content_back_lora": "omni_content_back.safetensors",
      "text_front_lora": "omni_text_front.safetensors",
      "text_back_lora": "omni_text_back.safetensors"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {"image": "hbo/graded_bottle.png"}
  },
  "3": {
    "class_type": "OmniPSDExtractLayers",
    "inputs": {
      "omnipsd_model": ["1", 0],
      "image": ["2", 0],
      "layer_names": "masts_rigging\nship_hull\nsea_resin\nbottle_glass\ntable\nbackground",
      "iterations": 3,
      "fallback_mode": "luminance"
    }
  },
  "4": {
    "class_type": "OmniPSDSavePSD",
    "inputs": {
      "images": ["3", 0],
      "layer_names": ["3", 2],
      "filename_prefix": "omni/bottle_layers",
      "compression": "rle",
      "embed_smart_objects": false
    }
  }
}
